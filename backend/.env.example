# Copia este archivo a backend/.env y completa los valores reales.
# backend/.env NUNCA se commitea.

# --- Django ---
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=False
# Los DOS dominios (ADR-A14): el público sirve la SPA, el otro el API y el admin.
ALLOWED_HOSTS=obs.predes.org.pe,observatorio.predes.org.pe,localhost,127.0.0.1
# El que se difunde y va en los correos.
SITE_URL=https://observatorio.predes.org.pe
# El del API/admin: base de las URL absolutas de media y tiles que devuelve el API.
BACKEND_URL=https://obs.predes.org.pe
# Prefijo del admin (con slash final). Cambiarlo en producción: /admin/ es lo primero que
# prueba cualquier escaneo automático. Tiene que coincidir con el `location` correspondiente de
# deploy/nginx/conf.d/observatorio.conf.
ADMIN_URL=loginseguro/
CSRF_TRUSTED_ORIGINS=https://obs.predes.org.pe,https://observatorio.predes.org.pe
# Orígenes que pueden llamar al API desde el navegador. Con dos dominios el CORS es
# obligatorio también en producción.
CORS_ALLOWED_ORIGINS=https://observatorio.predes.org.pe

# --- PostgreSQL (usadas por Django, el contenedor db y el backup) ---
POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=cambiar-password-fuerte
# `db` es el nombre del servicio en compose. Para correr manage.py desde el host:
# POSTGRES_HOST=localhost .venv/bin/python manage.py …
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Meilisearch ---
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=cambiar-master-key-larga
MEILI_ENV=production

# --- Gemini (resumen automático de PDFs) ---
# Sin llave, la acción "Generar resumen con IA" queda deshabilitada con aviso en el admin;
# la publicación nunca depende de ella.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# --- OpenRouter (IA de propósito general, vía la librería `openai`) ---
# Pasarela hacia cualquier modelo con un solo secreto (ADR-A22): el modelo se cambia aquí, sin
# tocar código. Sin llave, todo lo que dependa de IA queda deshabilitado con aviso; como con
# Gemini, la publicación nunca depende de ello. La llave se saca en https://openrouter.ai/keys
# y se comprueba con `manage.py ia_probar`.
OPENROUTER_API_KEY=
OPENROUTER_MODELO=deepseek/deepseek-v4-flash-0731
# Cómo se lee un PDF adjunto cuando una norma se redacta desde el enlace al diario oficial
# (ADR-D8). `pdf-text` saca la capa de texto y es gratuito. Si el PDF está ESCANEADO no tiene
# capa de texto y la ficha vuelve en blanco: entonces `mistral-ocr`, que sí lo lee y se cobra
# por página.
OPENROUTER_PDF_ENGINE=pdf-text

# --- Límites de peticiones del API (throttling DRF) ---
# Los valores de abajo SON los de producción: si no defines nada, rigen igual. Vaciar una
# variable DESACTIVA ese límite, y eso es solo para desarrollo — `compose.dev.yml` ya las vacía
# las tres, así que en el stack de dev no hace falta tocar nada aquí.
#
# Por qué existe la variable: la suite E2E no cabe en la cuota anónima (112 corridas con caché
# de navegador fría, a 8 peticiones por carga de portada, contra un techo de 1.000/hora), y al
# agotarse el API responde 429 durante el resto de la hora. En una prueba eso no se lee como un
# límite sino como un sitio caído.
API_THROTTLE_ANON=1000/hour
API_THROTTLE_DESCARGA=30/hour
API_THROTTLE_BEACON=600/min

# --- Correo (avisos del flujo editorial). Vacío => correos a consola (dev) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=observatorio@predes.org.pe

# --- Superusuario inicial (lo crea `manage.py seed` si no existe) ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Datos fuente y pipeline geoespacial ---
# Carpeta con los Excel y GeoJSON canónicos (145 MB, no versionados). En compose se monta
# data/layers en /datos.
DATOS_FUENTE_DIR=/datos
# Registros .txt de cada llamada a la IA. En compose lo monta OBSERVATORIO_REGISTROS del
# .env de la RAÍZ; aquí solo se dice dónde los busca Django dentro del contenedor.
IA_LOGS_DIR=/app/logs
# URL con la que el navegador headless que captura el mapa del PDF alcanza al backend.
RENDER_MAPA_BASE_URL=http://backend:8000
