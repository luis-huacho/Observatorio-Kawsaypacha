# CORS para el dominio de la SPA (ADR-A14). Los estáticos los sirve nginx, así que
# django-cors-headers no los ve: estas cabeceras tienen que estar aquí.
#
# GENERADO al arrancar desde SITE_DOMAIN (ver dominio-spa.inc.template). El valor tiene que
# coincidir EXACTAMENTE con CORS_ALLOWED_ORIGINS de backend/.env, o /api/ y /tiles/ discrepan.
add_header Access-Control-Allow-Origin "https://${SITE_DOMAIN}" always;
add_header Vary "Origin" always;
