# Variables que consume DOCKER COMPOSE (no Django). Copiar a .env en la raíz.
#
# Son las que compose interpola en `compose.yaml`: los dominios de nginx y los valores que Vite
# hornea en el bundle del frontend durante el build.
#
# Los secretos del backend van aparte, en backend/.env.

# Dominio que sirve la SPA. En una prueba local del modo producción: localhost
SITE_DOMAIN=observatorio.predes.org.pe

# --- Build del frontend (Vite los hornea en el bundle; no se leen en runtime) ---
VITE_API_URL=https://obs.predes.org.pe/api
VITE_SEARCH_URL=https://obs.predes.org.pe/search
VITE_TILES_URL=https://obs.predes.org.pe/tiles
# La imprime `manage.py meili_setup`. Es de solo búsqueda: puede ir en el bundle.
VITE_MEILI_SEARCH_KEY=
