# Copiar a .env y ajustar por entorno. No commitear .env.
#
# El frontend (observatorio.predes.org.pe) y el backend (obs.predes.org.pe) viven en
# dominios distintos, así que estas URL son absolutas. El backend habilita CORS para
# el dominio público, de modo que no hace falta proxy en Vite.

# Producción:
#   VITE_API_URL=https://obs.predes.org.pe/api
#   VITE_SEARCH_URL=https://obs.predes.org.pe/search
#   VITE_TILES_URL=https://obs.predes.org.pe/tiles
VITE_API_URL=http://localhost:8000/api
VITE_SEARCH_URL=http://localhost:8000/search
VITE_TILES_URL=http://localhost:8000/tiles

# Llave search-only de Meilisearch. La imprime `manage.py meili_setup`.
# Es segura por diseño (solo búsqueda, solo índices públicos); la master key nunca sale del backend.
VITE_MEILI_SEARCH_KEY=
